{
  "name": "ai-agent-code-review",
  "version": "1.0.0",
  "description": "AI Agent 自动化代码审查工作流",
  "main": ".ai-review/ai-agent-review.js",
  "scripts": {
    "lint": "eslint . --ext .js,.jsx --format stylish",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,yml,yaml}\"",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "review": "node .ai-review/ai-agent-review.js"
  },
  "keywords": [
    "code-review",
    "ai",
    "github-actions",
    "eslint",
    "static-analysis"
  ],
  "author": "INTREBRO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/INTREBRO/ai-agent-code-review.git"
  },
  "bugs": {
    "url": "https://github.com/INTREBRO/ai-agent-code-review/issues"
  },
  "homepage": "https://github.com/INTREBRO/ai-agent-code-review#readme",
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
