# Snyk 配置文件
# https://docs.snyk.io/products/snyk-cli/guides-for-our-cli/cli-reference-guide

# ========== 项目配置 ==========
project-name: your-project-name
org: your-org-name  # Snyk 组织名称

# ========== 包管理器配置 ==========
# 支持的包管理器：npm、yarn、pnpm、maven、gradle、pip、poetry、composer、go、. NET、terraform 等
packageManager: npm

# ========== 扫描配置 ==========
# 扫描所有项目（monorepo）
all-projects: false

# 排除的路径
exclude:
  - "**/node_modules/**"
  - "**/dist/**"
  - "**/build/**"
  - "**/coverage/**"
  - "**/*.test.js"
  - "**/*.spec.js"
  - "**/__tests__/**"
  - "**/tests/**"

# ========== 漏洞处理 ==========
# 严重级别漏洞的处理方式
severity-threshold: high  # low | medium | high | critical

# 仅在存在漏洞时失败（CI/CD 中使用）
fail-on: all  # all | upgradable | policy

# 忽略特定的漏洞 ID
ignore:
  # 示例：忽略特定的 CVE
  # "SNYK-JS-XXXXXXX":
  #   - "*"  # 全部忽略
  #   - "patch"  # 仅忽略 patch 版本

# ========== 报告配置 ==========
# 输出格式
report-format: json  # json | xml | sarif | text

# 输出文件
report-file: snyk-report.json

# ========== API 配置 ==========
# Snyk API 端点（本地部署时使用）
# endpoint: https://your-on-premise-snyk-instance.com/api

# ========== 监控配置 ==========
# 监控项目（发送到 Snyk 平台）
monitor: true

# 监控快照存活时间（天）
project-live-for: 30

# ========== 修复配置 ==========
# 自动修复漏洞
fix: false

# 升级版本时保留范围符号（^、~）
strict-upgrades: false

# ========== 环境变量 ==========
# 从环境变量读取配置
# api-token: ${SNYK_TOKEN}

# ========== Docker 配置 ==========
# Docker 镜像扫描配置
docker:
  image-name: your-docker-image:latest

# ========== IaC 配置 ==========
# 基础设施即代码扫描配置
iac:
  scan-all-iac-engines: true  # Terraform、Kubernetes、Helm 等

# ========== 代码安全配置 ==========
# Snyk Code（SAST）配置
code:
  scan: true
  severity-threshold: high

# ========== 许可证配置 ==========
# 开源许可证合规检查
license:
  severity-threshold: low  # 检查所有许可证问题

# ========== 高级配置 ==========
# 调试模式
debug: false

# 详细输出
verbose: false

# 禁用遥测
disable-analytics: true
